{
  "buildCommand": "vite build --outDir dist && PRERENDER_OUT_DIR=dist node tools/prerender.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/service-areas",
      "destination": "/areas-we-serve/",
      "permanent": true
    },
    {
      "source": "/service-areas/",
      "destination": "/areas-we-serve/",
      "permanent": true
    },
    {
      "source": "/services/roofing",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/roofing/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/roofing/:city",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/roof-repair",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/roof-repair/",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/roof-repair/:city",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/services/roof-insulation",
